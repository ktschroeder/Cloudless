<Window x:Class="Cloudless.QuickCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Commands"
        Height="322"
        Width="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        AllowsTransparency="True">

    <Grid PreviewMouseWheel="Window_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Page selector tabs -->
        <StackPanel x:Name="TabPanel" Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="6">
            <Button Name="Tab1" Click="TabButton_Click" Style="{StaticResource CloudlessButton}" Width="28" Height="22" Margin="2">1</Button>
            <Button Name="Tab2" Click="TabButton_Click" Style="{StaticResource CloudlessButton}" Width="28" Height="22" Margin="2">2</Button>
            <Button Name="Tab3" Click="TabButton_Click" Style="{StaticResource CloudlessButton}" Width="28" Height="22" Margin="2">3</Button>
        </StackPanel>

        <!-- Buttons around the perimeter -->
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="1" Grid.Column="0">
            <TextBlock Name="Quick1" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="1" Grid.Column="1">
            <TextBlock Name="Quick2" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="1" Grid.Column="2">
            <TextBlock Name="Quick3" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="2" Grid.Column="0">
            <TextBlock Name="Quick4" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
        <!-- Grid.Row=1, Grid.Column=1 is left empty for transparency -->
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="2" Grid.Column="2">
            <TextBlock Name="Quick5" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="3" Grid.Column="0">
            <TextBlock Name="Quick6" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="3" Grid.Column="1">
            <TextBlock Name="Quick7" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
        <Button Style="{StaticResource CloudlessButton}" Click="QuickButtonClick" Grid.Row="3" Grid.Column="2">
            <TextBlock Name="Quick8" TextWrapping="Wrap" TextAlignment="Center">
            </TextBlock>
        </Button>
    </Grid>

</Window>
