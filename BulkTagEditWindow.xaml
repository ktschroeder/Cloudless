<Window x:Class="Cloudless.BulkTagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit tags"
        Width="440"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="6" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Edit tags"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForeground}"/>
            <TextBlock x:Name="SelectedCountText"
                       Grid.Row="1"
                       Margin="0,6,0,12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Tags to modify (space-separated)"
                           Foreground="{DynamicResource PrimaryForeground}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TagsTextBox"
                         MinHeight="32"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         KeyDown="TagsTextBox_KeyDown"/>
            </StackPanel>
            <StackPanel x:Name="CurrentTagsPanel" Grid.Row="3" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="Tags on selected item"
                           Foreground="{DynamicResource SecondaryForeground}"
                           Margin="0,0,0,4"/>
                <ListBox x:Name="CurrentTagsList"
                         MaxHeight="90"
                         MouseDoubleClick="CurrentTagsList_MouseDoubleClick"
                         Background="{DynamicResource ControlBackground}"
                         Foreground="{DynamicResource PrimaryForeground}"
                         BorderBrush="{DynamicResource ControlBorderBrush}"/>
            </StackPanel>
            <DockPanel Grid.Row="4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="All existing tags"
                           Foreground="{DynamicResource SecondaryForeground}"
                           Margin="0,0,0,4"/>
                <ListBox x:Name="ExistingTagsList"
                         MouseDoubleClick="ExistingTagsList_MouseDoubleClick"
                         Background="{DynamicResource ControlBackground}"
                         Foreground="{DynamicResource PrimaryForeground}"
                         BorderBrush="{DynamicResource ControlBorderBrush}"/>
            </DockPanel>
            <TextBlock x:Name="ValidationText"
                        Grid.Row="5"
                       Foreground="#FFE57373"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource CloudlessButton}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Remove from selected"
                        Style="{StaticResource CloudlessButton}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="RemoveTags_Click"/>
                <Button Content="Add to selected"
                        Style="{StaticResource CloudlessPrimaryButton}"
                        Padding="12,6"
                        Click="AddTags_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
