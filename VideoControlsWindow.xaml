<Window x:Class="Cloudless.VideoControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False">

    <Border Background="{DynamicResource OverlayBackground}" 
            Padding="8" 
            CornerRadius="4,4,0,0"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1,1,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Progress Bar -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Slider x:Name="SeekingSlider" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="0"
                        VerticalAlignment="Center"
                        Margin="0,0,0,4"
                        PreviewMouseDown="SeekingSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekingSlider_PreviewMouseUp"/>

                <!-- Overlay canvas for static loop start/end markers -->
                <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Rectangle x:Name="StartMarker" Width="3" Height="14" Visibility="Collapsed" Fill="LimeGreen" RadiusX="1" RadiusY="1" />
                    <!-- Flag marker: small gold chevron for quick-seek flag -->
                    <Polygon x:Name="FlagMarker" Points="0,0 7,7 14,0 11,0 7,4 3,0" Visibility="Collapsed" Fill="Gold" Width="14" Height="7" IsHitTestVisible="False" Canvas.ZIndex="100" />
                    <!-- Trigger marker: blue 'T' placed at the trigger time. Placed before EndMarker so EndMarker remains on top when both present. -->
                    <TextBlock x:Name="TriggerMarker" Text="T" Width="27" Height="27" Visibility="Collapsed" Foreground="DodgerBlue" FontWeight="Bold" FontSize="27" FontFamily="Segoe UI Black" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Rectangle x:Name="EndMarker" Width="3" Height="14" Visibility="Collapsed" Fill="OrangeRed" RadiusX="1" RadiusY="1" />
                </Canvas>
            </Grid>

            <!-- Current Time -->
            <TextBlock x:Name="CurrentTimeText" 
                       Grid.Row="1" 
                       Grid.Column="0"
                       Text="0:00"
                       Foreground="{DynamicResource PrimaryForeground}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <!-- Duration -->
            <TextBlock x:Name="DurationText" 
                       Grid.Row="1" 
                       Grid.Column="2"
                       Text="0:00"
                       Foreground="{DynamicResource PrimaryForeground}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>

            <!-- Volume controls (center area) -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,8,0">
                <!-- Play/Pause button -->
                <Button x:Name="PlayPauseButton" Width="65" Height="22" Padding="0" Margin="0,0,6,0" Click="PlayPauseButton_Click" ToolTip="Play/Pause" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Pause</Button>
                <!-- Mute/Unmute button -->
                <Button x:Name="MuteButton" Width="65" Height="22" Padding="0" Margin="0,0,6,0" Click="MuteButton_Click" ToolTip="Mute/Unmute">
                    <TextBlock x:Name="MuteIcon" Text="??" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Volume slider gauge -->
                <Slider x:Name="VolumeSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        Width="160"
                        Height="22"
                        VerticalAlignment="Center"
                        Margin="0,2,6,2"
                        PreviewMouseDown="VolumeSlider_PreviewMouseDown"
                        PreviewMouseMove="VolumeSlider_PreviewMouseMove"
                        PreviewMouseUp="VolumeSlider_PreviewMouseUp"/>

                <!-- Percentage text (read-only) with fixed width to avoid layout shifts -->
                <TextBlock x:Name="VolumePercentText" Text="100%" Foreground="{DynamicResource PrimaryForeground}" FontSize="12" VerticalAlignment="Center" Width="40" TextAlignment="Center"/>
                <!-- Sync indicator: shows 'S' when synced, 'S?' when waiting -->
                <TextBlock x:Name="SyncIndicator" Text="" Foreground="LimeGreen" FontSize="12" VerticalAlignment="Center" Width="36" TextAlignment="Center" ToolTip="Video sync status"/>
                <!-- Trigger indicator: shows 'T: X/Y' when this is a trigger window (X current hits, Y required hits) -->
                <TextBlock x:Name="TriggerIndicator" Text="" Foreground="DodgerBlue" FontSize="12" VerticalAlignment="Center" Width="45" TextAlignment="Center" ToolTip="Trigger hit counter"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
