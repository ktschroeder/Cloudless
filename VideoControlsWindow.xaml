<Window x:Class="Cloudless.VideoControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False">

    <Border Background="{DynamicResource SecondaryBackground}" 
            Padding="8" 
            CornerRadius="4,4,0,0"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1,1,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Progress Bar -->
            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <Slider x:Name="SeekingSlider" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="0"
                        VerticalAlignment="Center"
                        Margin="0,0,0,4"
                        PreviewMouseDown="SeekingSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekingSlider_PreviewMouseUp"/>

                <!-- Overlay canvas for static loop start/end markers -->
                <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Rectangle x:Name="StartMarker" Width="3" Height="14" Visibility="Collapsed" Fill="OrangeRed" RadiusX="1" RadiusY="1" />
                    <Rectangle x:Name="EndMarker" Width="3" Height="14" Visibility="Collapsed" Fill="LimeGreen" RadiusX="1" RadiusY="1" />
                </Canvas>
            </Grid>

            <!-- Current Time -->
            <TextBlock x:Name="CurrentTimeText" 
                       Grid.Row="1" 
                       Grid.Column="0"
                       Text="0:00"
                       Foreground="{DynamicResource PrimaryForeground}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <!-- Duration -->
            <TextBlock x:Name="DurationText" 
                       Grid.Row="1" 
                       Grid.Column="2"
                       Text="0:00"
                       Foreground="{DynamicResource PrimaryForeground}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>

            <!-- Volume controls (center area) -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,8,0">
                <!-- Play/Pause button -->
                <Button x:Name="PlayPauseButton" Width="65" Height="22" Padding="0" Margin="0,0,6,0" Click="PlayPauseButton_Click" ToolTip="Play/Pause" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Pause</Button>
                <!-- Mute/Unmute button -->
                <Button x:Name="MuteButton" Width="65" Height="22" Padding="0" Margin="0,0,6,0" Click="MuteButton_Click" ToolTip="Mute/Unmute">
                    <TextBlock x:Name="MuteIcon" Text="??" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Volume slider gauge -->
                <Slider x:Name="VolumeSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        Width="160"
                        Height="22"
                        VerticalAlignment="Center"
                        Margin="0,2,6,2"
                        PreviewMouseDown="VolumeSlider_PreviewMouseDown"
                        PreviewMouseMove="VolumeSlider_PreviewMouseMove"
                        PreviewMouseUp="VolumeSlider_PreviewMouseUp"/>

                <!-- Percentage text (read-only) with fixed width to avoid layout shifts -->
                <TextBlock x:Name="VolumePercentText" Text="100%" Foreground="{DynamicResource PrimaryForeground}" FontSize="11" VerticalAlignment="Center" Width="40" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
