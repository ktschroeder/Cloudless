<Window x:Class="Cloudless.MouseModeRefWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Mouse Mode Reference"
    Height="600"
    Width="832"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="Transparent"
    MouseDown="Window_MouseDown"
    KeyDown="Window_KeyDown"
    PreviewMouseWheel="Window_PreviewMouseWheel"
    AllowsTransparency="True">

    <Grid Margin="16">
        <Border Background="{DynamicResource WindowBackground}" CornerRadius="6" Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>

            <DockPanel>
                <Border Background="{DynamicResource SecondaryBackground}"
                        Padding="8"
                        DockPanel.Dock="Top"
                        CornerRadius="6,6,0,0">
                    <TextBlock Text="Mouse Mode Reference"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForeground}"/>
                </Border>

                <StackPanel Margin="12">
                    <StackPanel>
                        <StackPanel x:Name="ContentArea">
                            <TabControl x:Name="TabControlReference"
                                        Background="Transparent"
                                        BorderThickness="0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Content="Close"
                                    Style="{StaticResource CloudlessPrimaryButton}"
                                    Click="Close_Click"
                                    FontWeight="SemiBold"
                                    Width="60"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
