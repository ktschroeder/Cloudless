<Window x:Class="Cloudless.MessageHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message History"
        Height="442"
        Width="632"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        AllowsTransparency="True">

    <Grid Margin="16">
    <Border Background="{DynamicResource WindowBackground}"
            CornerRadius="6"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>


        <DockPanel>

            <!-- Header -->
            <Border Background="{DynamicResource SecondaryBackground}"
                    Padding="8"
                    DockPanel.Dock="Top"
                    CornerRadius="6,6,0,0">
                <TextBlock Text="System Messages"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </Border>

            <!-- Content -->
            <StackPanel Margin="12" DockPanel.Dock="Top">

                <TextBlock Text="Messages:"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForeground}"
                           Margin="0,0,0,8"/>

                <RichTextBox x:Name="MessageRichTextBox" 
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Height="288"
                             Background="{DynamicResource TextBoxBackground}" 
                             BorderBrush="{DynamicResource ControlBorderBrush}" 
                             BorderThickness="1"
                             Padding="4"
                             Foreground="{DynamicResource PrimaryForeground}"
                             FontFamily="Courier New"
                             FontSize="11"/>

            </StackPanel>

            <!-- Close Button -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,12,12"
                        DockPanel.Dock="Bottom">
                <Button Content="Close"
                        Style="{StaticResource CloudlessPrimaryButton}"
                        Click="Close_Click"
                        FontWeight="SemiBold"
                        Width="60"/>
            </StackPanel>

        </DockPanel>
    </Border>
    </Grid>
</Window>
