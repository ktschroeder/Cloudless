<Window x:Class="Cloudless.HotkeyRefWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hotkey Reference"
    Height="600"
    Width="800"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="Transparent"
    MouseDown="Window_MouseDown"
    KeyDown="Window_KeyDown"
    AllowsTransparency="True">

    <Border Background="{DynamicResource WindowBackground}"
            CornerRadius="6"
            Padding="0">

        <DockPanel>
            <!-- Header -->
            <Border Background="{DynamicResource SecondaryBackground}"
                    Padding="8"
                    DockPanel.Dock="Top"
                    CornerRadius="6,6,0,0">
                <TextBlock Text="Hotkey Reference"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </Border>

            <!-- Content with ScrollViewer -->
            <StackPanel Margin="12">
                <StackPanel>
                    <StackPanel x:Name="ContentArea" Margin="0,0,0,0">
                        <TabControl x:Name="TabControlReference" Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="Close"
                                Style="{StaticResource CloudlessPrimaryButton}"
                                Click="Close_Click"
                                FontWeight="SemiBold"
                                Width="60"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
