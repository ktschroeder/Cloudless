<Window x:Class="Cloudless.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cloudless"
        Title="Image Gallery"
        Width="567"
        SizeToContent="Height"
        MaxHeight="632"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid Margin="16">
    <Border Background="{DynamicResource WindowBackground}"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <DockPanel>

            <!-- Header -->
            <Border Background="{DynamicResource SecondaryBackground}"
                    Padding="8"
                    DockPanel.Dock="Top"
                    CornerRadius="6,6,0,0">
                <TextBlock Name="TitleText"
                           Text="Image Gallery"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </Border>

            <!-- Content -->
            <DockPanel Margin="12">

                <WrapPanel DockPanel.Dock="Top"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8">
                    <WrapPanel x:Name="SelectionActionsPanel"
                               VerticalAlignment="Center"
                               Margin="0">
                        <TextBlock x:Name="SelectionCountText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForeground}"
                                   Margin="0,0,10,0"/>
                        <Button Content="Select all"
                                Style="{StaticResource CloudlessButton}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="SelectAll_Click"/>
                        <Button x:Name="EditSelectedTagsButton"
                                Content="Edit tags"
                                Style="{StaticResource CloudlessButton}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="EditSelectedTags_Click"/>
                        <Button x:Name="BookmarkSelectedButton"
                                Content="Bookmark"
                                Style="{StaticResource CloudlessButton}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="BookmarkSelected_Click"/>
                        <Button x:Name="RemoveBookmarksButton"
                                Content="Remove bookmarks"
                                Style="{StaticResource CloudlessButton}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Click="RemoveBookmarks_Click"/>
                        <Button x:Name="ClearSelectionButton"
                                Content="Clear selection"
                                Style="{StaticResource CloudlessButton}"
                                Padding="10,4"
                                Click="ClearSelection_Click"/>
                    </WrapPanel>
                </WrapPanel>

                <!-- Bottom Close Button -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button Content="Send to filmstrip"
                            Style="{StaticResource CloudlessButton}"
                            Name="FilmstripButton"
                            Click="FilmstripButton_Click"
                            Width="120"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0"/>
                    <Button Content="Preview Another WS"
                            Style="{StaticResource CloudlessButton}"
                            Name="WorkspacePreviewButton"
                            Click="Workspace_Preview_Click"
                            Width="150"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"/>
                    <Button Content="Load"
                            Style="{StaticResource CloudlessButton}"
                            Name="WorkspaceLoadButton"
                            Click="Workspace_Load_Click"
                            Width="60"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"/>
                    <Button Content="Merge"
                            Style="{StaticResource CloudlessButton}"
                            Name="WorkspaceMergeButton"
                            Click="Workspace_Merge_Click"
                            Width="60"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"/>
                    <Button Content="Close"
                            Style="{StaticResource CloudlessPrimaryButton}"
                            Click="Close_Click"
                            Width="60"
                            FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Scrollable Thumbnail Grid -->
                <ScrollViewer x:Name="GalleryScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GalleryItemsControl" ItemsSource="{Binding GalleryImages}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"
                                           ItemWidth="160"
                                           ItemHeight="178"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                    <Border CornerRadius="4"
                                            Margin="6"
                                            Cursor="Hand"
                                            Loaded="Thumbnail_Loaded"
                                            ContextMenuOpening="Thumbnail_ContextMenuOpening">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <StackPanel MouseLeftButtonDown="Thumbnail_Click">

                                        <Grid Width="128" Height="128" Margin="4"
                                              ToolTip="{Binding TooltipFileName}"
                                              ToolTipService.InitialShowDelay="500"
                                              ToolTipService.BetweenShowDelay="0">
                                            <Image Source="{Binding Thumbnail}"
                                                   Width="128"
                                                   Height="128"
                                                   Stretch="UniformToFill"/>
                                            <local:VideoThumbnailOverlay IsVideo="{Binding IsVlcVideo}"/>
                                            <local:AnimatedThumbnailOverlay IsAnimated="{Binding IsAnimated}"/>
                                            <Path Data="M 0,0 L 22,0 L 0,22 Z"
                                                  Width="22"
                                                  Height="22"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Fill="#168BFF"
                                                  IsHitTestVisible="False">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Border Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="4"
                                                    Background="#99000000"
                                                    CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Path Data="M 2,9 L 7,14 L 17,3"
                                                      Stroke="White"
                                                      StrokeThickness="3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Margin="4"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForeground}"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="4,4,4,6"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>

        </DockPanel>
    </Border>
    </Grid>
</Window>
