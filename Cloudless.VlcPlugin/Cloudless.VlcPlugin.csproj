<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Ensure NuGet-resolved managed assemblies are copied to the plugin output -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="manifest.json" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="manifest.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibVLCSharp" Version="3.10.1" />
		<PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cloudless.PluginBase\Cloudless.PluginBase.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="HostedPlugin\" />
	</ItemGroup>

</Project>
